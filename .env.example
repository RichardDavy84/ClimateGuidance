# Copy to .env for local tests; production secrets belong in your host's secret store.
PAYMENT_MODE=test
SITE_ORIGIN=http://127.0.0.1:8766
HOST=127.0.0.1
PORT=8787
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DIGITAL_PRICE_ID=price_...
# Sample Checkout Studio URLs: replace with the real site paths described in STRIPE_INTEGRATION_TODO.md.
STRIPE_SUCCESS_URL=http://127.0.0.1:8766/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://127.0.0.1:8766
PAYMENT_LEDGER_DIR=.payment-data
BOOK_PDF_PATH=
BOOK_EPUB_PATH=
